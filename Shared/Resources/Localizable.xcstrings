    "onboarding_notifications_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تفوّت صلاة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never miss a prayer"
          }
        }
      }
    },
    "onboarding_offline_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب مواقيت الصلاة على هذا الجهاز. لا حاجة إلى اتصال بالإنترنت أبدًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer times are calculated on this device. No connection is ever required."
          }
        }
      }
    },
    "onboarding_offline_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل دون إنترنت"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works offline"
          }
        }
      }
    },
    "onboarding_privacy_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى موقعك على جهازك ولا يُرسل إلى أي جهة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location stays on your device. It is never sent anywhere."
          }
        }
      }
    },
    "onboarding_privacy_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خصوصيتك محفوظة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private by design"
          }
        }
      }
    },
    "onboarding_skip": {
      "extractionState": "manual",
