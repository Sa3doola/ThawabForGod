    "tip_home_hijri_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع هذا التاريخ تقويم أم القرى، وهو تقويم محسوب لا يعتمد على الرؤية، وقد تتقدم رؤية الهلال محليًا أو تتأخر عنه بيوم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This date follows the Umm al-Qura calendar, which is calculated rather than sighted — a local moon sighting can put the real date a day either side of it."
          }
        }
      }
    },
    "tip_home_hijri_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
