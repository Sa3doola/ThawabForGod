    "settings_privacy_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم موقعك لحساب مواقيت الصلاة واتجاه القبلة فقط، ولا يغادر جهازك أبداً."
          }
