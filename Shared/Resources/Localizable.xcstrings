    "onboarding_notifications_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصلك تذكيرات هادئة عند دخول وقت كل صلاة، ويمكنك تعديلها أو إيقافها في أي وقت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a quiet reminder at the start of each prayer time. You can change or turn these off at any time."
          }
        }
      }
    },
    "onboarding_notifications_denied_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التذكيرات متوقفة، ويعمل التطبيق تمامًا كما هو بدونها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders are off. The app works exactly the same without them."
          }
        }
      }
    },
    "onboarding_notifications_granted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تفعيل التذكيرات"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders enabled"
          }
        }
