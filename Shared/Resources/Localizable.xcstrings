    "prayer_info_asr": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صلاة العصر. يختلف بدء وقتها باختلاف المذهب — الشافعي أو الحنفي، ويمكنك اختياره في الإعدادات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The afternoon prayer. When its window opens depends on the school you follow — Shafi or Hanafi, which you can set in Settings."
          }
        }
      }
    },
    "prayer_info_dhuhr": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صلاة الظهر. يبدأ وقتها بعد زوال الشمس عن كبد السماء."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The midday prayer. Its window opens once the sun has passed its zenith."
          }
        }
      }
    },
    "prayer_info_fajr": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صلاة الفجر. يبدأ وقتها بطلوع الفجر الصادق وينتهي بشروق الشمس."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dawn prayer. Its window opens at true dawn and closes at sunrise."
          }
        }
      }
    },
    "prayer_info_isha": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صلاة العشاء. يبدأ وقتها بمغيب الشفق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The night prayer. Its window opens once the twilight has gone."
          }
        }
      }
    },
    "prayer_info_maghrib": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صلاة المغرب. يبدأ وقتها بمجرد غروب الشمس كاملة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sunset prayer. Its window opens as soon as the sun has fully set."
          }
        }
      }
    },
    "prayer_info_sunrise": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس صلاة. الشروق ينهي وقت الفجر ولا يبدأ وقتاً جديداً."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a prayer. Sunrise ends the window for Fajr — it does not begin one of its own."
