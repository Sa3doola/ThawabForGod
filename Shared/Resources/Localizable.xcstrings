    "settings_menu_bar_style_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسقط الوضع التلقائي اسم الصلاة ثم الرمز كلما ازدحم شريط القوائم. والعدّ التنازلي آخر ما يُسقط."
          }
        },
        "en": {
          "stringUnit": {
