    "onboarding_welcome_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مواقيت الصلاة والقبلة والأذكار وغيرها — تُحسب على جهازك، أينما كنت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer times, Qibla, adhkar and more — calculated on your device, for wherever you are."
