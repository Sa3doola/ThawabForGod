    "onboarding_location_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد موقعك مواقيت صلاتك واتجاه القبلة، ويبقى على هذا الجهاز."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location sets your prayer times and the direction of the Qibla. It stays on this device."
          }
        }
      }
    },
    "onboarding_location_denied_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مشكلة — أدخل إحداثياتك يدويًا وسيعمل كل شيء كالمعتاد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No problem — enter your coordinates instead and everything still works."
          }
        }
      }
    },
