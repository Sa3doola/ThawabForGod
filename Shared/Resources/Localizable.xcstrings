    "hadith_scope_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحمل التطبيق الصحيحين وحدهما، بالعربية دون ترجمة. فالمرويّ في غيرهما يحتاج إلى بيان درجته، وأحكام المحدّثين المعاصرين محفوظة الحقوق، والترجمات الإنجليزية كذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app carries the two Sahihs alone, in Arabic and untranslated. A narration from any other collection needs its grading beside it, and every published grading — like every English translation of these books — is modern work under copyright."
          }
        }
      }
    },
