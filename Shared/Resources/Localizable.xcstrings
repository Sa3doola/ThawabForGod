    "onboarding_method_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اخترنا الطريقة الأكثر شيوعًا في منطقتك، ويمكنك تغييرها لاحقًا من الإعدادات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We picked the method most common where you are. You can change this later in Settings."
          }
        }
      }
    },
