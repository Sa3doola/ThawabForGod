<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	 Merged into the generated Info.plist (GENERATE_INFOPLIST_FILE = YES stays on;
	 this file is additive, not a replacement) for the one key Xcode's INFOPLIST_KEY_*
	 synthesis does not support: BGTaskSchedulerPermittedIdentifiers must be a real
	 array, and no build setting produces that for this key, confirmed by inspecting
	 the built app's Info.plist with and without a clean build.

	 See BackgroundRefreshScheduler.swift for what registers under this identifier.
	 Harmless on macOS, where nothing calls BGTaskScheduler.register(_:) — the
	 background-refresh code is #if os(iOS) only.
	-->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.Sa3dola.ThawabForGod.refreshReminders</string>
	</array>

	<!--
	 The one URL scheme, and the reason it exists: a widget tap, a Home Screen quick
	 action and a Dock menu item all have to name a destination from outside the
	 process, and a URL is the only vocabulary all three can carry. See DeepLink.swift,
	 which is the single place these hosts are written down on the Swift side.

	 Here for the same reason the key above is: CFBundleURLTypes is an array of
	 dictionaries, which INFOPLIST_KEY_* synthesis cannot express.

	 Both platforms. macOS registers the scheme through LaunchServices from the same key.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.Sa3dola.ThawabForGod</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>noor</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
