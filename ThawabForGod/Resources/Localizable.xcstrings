        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off for Noor. Turn them on in the Settings app to receive reminders."
          }
        }
      }
    },
    "settings_reminders_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصلك تذكير عند كل صلاة تتركها مفعّلة. تُجدوَل التذكيرات لنحو عشرة أيام مقدَّمًا، وتتجدد كلما فتحت التطبيق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reminder arrives at each prayer time you leave switched on. They are scheduled about ten days ahead and refill whenever you open the app."
          }
        }
      }
    },
