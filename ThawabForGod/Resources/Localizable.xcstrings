    "tip_home_hijri_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع هذا التاريخ تقويم أم القرى، وهو تقويم محسوب لا يعتمد على الرؤية، وقد تتقدم رؤية الهلال محليًا أو تتأخر عنه بيوم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This date follows the Umm al-Qura calendar, which is calculated rather than sighted — a local moon sighting can put the real date a day either side of it."
          }
        }
      }
    },
    "tip_home_hijri_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التاريخ الهجري"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Hijri date"
          }
        }
      }
    },
    "tip_home_tomorrow_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقضى وقت العشاء، فأصبح العد التنازلي إلى فجر الغد، لا إلى فجر اليوم المذكور في القائمة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Isha has passed, so the countdown now points at tomorrow's Fajr — not the one already listed for today."
          }
        }
      }
    },
    "tip_home_tomorrow_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العد التنازلي إلى الغد"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counting down to tomorrow"
          }
        }
      }
    },
    "tip_names_tap_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح أي اسم لترى معناه ومواضعه في القرآن."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open any name to see its meaning and where it appears in the Quran."
