    "adhkar_verification_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الأذكار مأخوذة من حصن المسلم. لم تُراجَع النصوص ومصادرها بعدُ على نسخة مطبوعة، والمرجع المذكور تحت كل ذكر ليتسنّى لك التحقق منه بنفسك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These adhkar follow Hisn al-Muslim. The text and its sources have not yet been checked against a printed copy — the reference under each dhikr is there so you can verify it yourself."
          }
        }
      }
    },
