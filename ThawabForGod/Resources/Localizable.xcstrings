    "tip_home_tomorrow_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقضى وقت العشاء، فأصبح العد التنازلي إلى فجر الغد، لا إلى فجر اليوم المذكور في القائمة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isha has passed, so the countdown now points at tomorrow's Fajr — not the one already listed for today."
          }
        }
      }
    },
