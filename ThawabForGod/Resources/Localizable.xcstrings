          }
        }
      }
    },
    "tip_onboarding_method_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طريقة الحساب ومذهب العصر ليسا ثابتين، ويمكنك تعديلهما في أي وقت من الإعدادات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your calculation method and Asr madhab are not fixed — adjust them at any time in Settings."
          }
        }
      }
