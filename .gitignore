.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Xcode - user-specific
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.xcscmblueprint
*.xccheckout
*.moved-aside

# Xcode - build products
build/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Xcode - other
*.perspectivev3
!default.perspectivev3
*.mode1v3
*.mode2v3
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
.build/
.swiftpm/
# SwiftPM 3 and 4 checked dependencies out for editing into a top-level Packages/ folder,
# which is what this line was for and what it still ignores. Packages/ArabicText is not a
# checkout but this repo's own local package (the Arabic folding shared by the app and
# Tools/QuranBuilder), so it is the one entry let through.
/Packages/*
!/Packages/ArabicText/
# Package.resolved is deliberately NOT ignored. It pins Adhan and GRDB to exact
# revisions, and a CI runner that resolves them freshly would otherwise build a
# different app from the one tested here.

# CocoaPods
Pods/

# Carthage
Carthage/Build/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Accio / misc
Dependencies/
.accio/

# Injection / profiling
iOSInjectionProject/
*.trace

# Quran migration: QUL-derived data. QUL publishes no license and this repo is
# public, so the raw downloads and everything built from them stay local. The
# public build uses Tools/QuranBuilder's `tanzil` profile instead (see
# QURAN_MIGRATION_PLAN.md, D1 and T4). QuranData/SOURCES.md and
# fonts-v2.sha256 are hashes and notes only, and are committed.
QuranData/raw/
QuranData/out/
# Full-data outputs of the `qul` profile, wherever they land.
quran-mushaf.sqlite
translation-en-sahih-international.sqlite
tafsir-ar-muyassar.sqlite
tafsir-en-mukhtasar.sqlite
surah-info-*.sqlite
# QUL fonts: the 604 QPC V2 page fonts, and the header, name and common faces.
madaniV2/
surah-header.ttf
surah-name-v2.ttf
quran-common.ttf
